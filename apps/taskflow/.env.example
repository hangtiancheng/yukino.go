# Copy to .env (same directory as docker-compose.yml) and fill in.
# docker compose reads this file automatically.

# Shared by the MySQL container and the server (mysql.password_env).
MYSQL_PASSWORD=taskflow_secret
REPLICATION_PASSWORD=taskflow_replication_secret

# LLM (openai-go); any OpenAI-compatible endpoint works.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional server sentry/go DSN; empty = noop mode.
SENTRY_DSN=

# API access token and time-wheel callback token. Set for network deployments.
TASKFLOW_API_TOKEN=
TASKFLOW_INTERNAL_TOKEN=

# Optional host port overrides.
SERVER_PORT=8090
CLIENT_PORT=8080
