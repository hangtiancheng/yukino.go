# Copy to .env.local (Vite reads it automatically) and fill in as needed.

# Server origin used by the API client. Leave empty for same-origin requests:
# the vite dev proxy (dev) and the nginx image (docker) forward /api to the
# server, so no host is hardcoded. Set it to an absolute origin
# (e.g. https://api.taskflow.example.com) to call the server cross-origin.
VITE_SERVER_BASE_URL=""

# Client monitoring (yukino-sentry) report endpoint. Leave empty to use the
# dev mock endpoint / same-origin proxy path (/api/v1/telemetry/log). Set it to
# a real collector URL in production.
VITE_SENTRY_DSN=""
