# Copy to .env and fill in real values. Never commit .env.

# OpenAI-compatible LLM endpoint. Any provider works; the backend calls
# {LLM_BASE_URL}/chat/completions with a Bearer key.
LLM_API_KEY=
LLM_BAS…m/v1
LLM_MAIN_MODEL=qwen-plus
LLM_LIGHT_MODEL=qwen-turbo

# MySQL password for the takeout_db database (database.password_env)
MYSQL_PASSWORD=
