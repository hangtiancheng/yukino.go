# Env vars are derived from the config JSON paths (uppercase + underscores) and override config.json / secrets.json.

# Server (local nginx occupies 8080, so use 18080; the client vite proxy points to 18080 by default)
SERVER_PORT=18080

# JWT
JWT_SECRET=change-me-in-production

# Logging (debug, info, warn, error)
LOG_LEVEL=info

# MySQL (local middleware: ~/github/hangtiancheng/docker-compose.yml)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=user
MYSQL_PASSWORD=pass
MYSQL_DATABASE=db0

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Async pipeline (worker / consumer / poller)
ASYNC_ENABLED=true

# LLM: provider=openai (OpenAI-compatible, default) | claude (Anthropic)
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash

# OpenTelemetry (OTLP gRPC exporter)
OTEL_ENABLED=false
OTEL_EXPORTER_ENDPOINT=localhost:4317
OTEL_SERVICE_NAME=yukino-creative-agent

# Sentry error reporting (disabled when the DSN is empty)
SENTRY_DSN=

# Prometheus /metrics
METRICS_ENABLED=true

# External services
IDEA_KING_BASE_URL=
