# 环境变量按 config 的 json 路径派生（大写 + 下划线），覆盖 config.json / secrets.json。

# Server
SERVER_PORT=8080

# JWT
JWT_SECRET=change-me-in-production

# Logging (debug, info, warn, error)
LOG_LEVEL=info

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=all_in_one

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 异步管道（worker / consumer / poller）
ASYNC_ENABLED=true

# LLM：provider=openai（OpenAI 兼容，默认）| claude（Anthropic）
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash

# OpenTelemetry（OTLP gRPC exporter）
OTEL_ENABLED=false
OTEL_EXPORTER_ENDPOINT=localhost:4317
OTEL_SERVICE_NAME=yukino-creative-agent

# Sentry 错误上报（DSN 为空不启用）
SENTRY_DSN=

# Prometheus /metrics
METRICS_ENABLED=true

# 外部服务
IDEA_KING_BASE_URL=
