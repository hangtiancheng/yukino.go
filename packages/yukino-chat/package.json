{
  "name": "yukino-chat",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dual": "concurrently \"pnpm dev\" \"pnpm dev\"",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "format": "prettier -w ./ --experimental-cli",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@lit-labs/router": "^0.1.4",
    "@lit-labs/signals": "^0.3.0",
    "@yukino.js/lit-jsx": "latest",
    "clsx": "^2.1.1",
    "lit": "^3.3.3",
    "lucide": "^1.43.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.4",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2"
  }
}
